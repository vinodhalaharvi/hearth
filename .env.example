# Copy to .env and fill in real values. .env is gitignored — never commit it.
# The Makefile sources this into the environment before `cargo run`, and the
# firmware reads these as compile-time constants (with safe placeholder
# fallbacks so the crate still compiles without a .env).

# WiFi — the ESP32-S3 radio is 2.4 GHz only.
WIFI_SSID=your-network
WIFI_PASS=your-password

# MQTT broker (the local Mosquitto from the node-mcu setup).
MQTT_HOST=192.168.68.139
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Node identity is chip-derived by default: with no NODE_ID set, each board
# self-names as `<prefix>-<mac-suffix>` (e.g. esp32s3-3c9a1f), unique per
# physical chip — so flashing a second board of the same type never collides.
# The prefix is NODE_PREFIX in each firmware crate. It is the middle topic
# segment: hearth/<node-id>/<metric>.
#
# Set NODE_ID only to give ONE board a stable, friendly name instead:
#NODE_ID=living-room
