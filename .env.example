# Copy to .env and fill in real values. .env is gitignored — never commit it.
# The Makefile sources this into the environment before `cargo run`, and the
# firmware reads these as compile-time constants (with safe placeholder
# fallbacks so the crate still compiles without a .env).

# WiFi — the ESP32-S3 radio is 2.4 GHz only.
WIFI_SSID=your-network
WIFI_PASS=your-password

# MQTT broker (the local Mosquitto from the node-mcu setup).
MQTT_HOST=192.168.68.139
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Node identity is NOT set here — it lives in each firmware crate as the
# NODE_ID fallback (esp32s3-sensor -> "esp32s3-01", xiao-sense -> "xiao-sense-01"),
# so this one shared file serves every board. It is the middle topic segment:
#   hearth/<node-id>/<metric>
# (Export NODE_ID in your shell to override a single build if you ever need to.)
