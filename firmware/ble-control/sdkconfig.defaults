# hearth · ble-control — BLE (NimBLE) on the ESP32-S3 DevKitC. No WiFi/MQTT.

# Bluetooth: enable the controller + NimBLE host; disable Bluedroid.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Roomy main-task stack for BLE host init + LED setup.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000

# 1 kHz tick so std sleeps are granular.
CONFIG_FREERTOS_HZ=1000
